# ---- Runtime ----
NODE_ENV=development
PORT=7102

# ---- MongoDB ----
# Local:  mongodb://127.0.0.1:27017/wedding_music
# Atlas:  mongodb+srv://<user>:<password>@<cluster>.mongodb.net/wedding_music?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://techtadka61_db_user:<db_password>@cluster0.nrdawri.mongodb.net/

# ---- HTTP ----
# Comma-separated list of browser origins allowed to call the API.
CORS_ORIGINS=http://localhost:7101
# Set to true when running behind Nginx so rate limiting sees the real client IP.
TRUST_PROXY=false
# Requests allowed per IP per window.
RATE_LIMIT_TTL_SECONDS=60
RATE_LIMIT_MAX_REQUESTS=120
# Serve Swagger UI at /api/docs.
SWAGGER_ENABLED=true

# ---- AWS S3 (validated from Milestone 2) ----
# No access keys here. The AWS SDK finds credentials automatically:
#   - on EC2: the attached IAM instance role
#   - locally: your ~/.aws/credentials profile (`aws configure`), never this file
AWS_REGION=ap-southeast-2b
AWS_S3_BUCKET=nexqira-s3

# ---- Storage ----
# s3    = AWS S3 (production / EC2; needs AWS_REGION + AWS_S3_BUCKET above)
# local = files on disk + signed URLs served by this API (development only, needs a secret)
STORAGE_DRIVER=s3
# Lifetime of stream/artwork URLs handed to browsers.
STREAM_URL_TTL_SECONDS=3600
# Public base URL of this API (used for local-driver URLs).
API_PUBLIC_URL=http://localhost:7102
# Only for STORAGE_DRIVER=local:
# LOCAL_STORAGE_DIR=.storage
# STORAGE_SIGNING_SECRET=<random 32+ chars: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))">
