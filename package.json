    "mongodb-memory-server": "^11.3.0",
    "oxlint": "^1.58.0",
    "source-map-support": "^0.5.21",
    "supertest": "^7.3.2",
    "typescript": "~6.0.3",
    "unplugin-swc": "^2.0.0",
    "vitest": "^5.1.1"
  }
}
